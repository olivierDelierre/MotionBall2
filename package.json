{
  "name": "motionball2-rewrite",
  "version": "1.0.0",
  "private": true,
  "description": "MotionBall 2 (Motion Twin / Frutiparc, 2005) rewritten in TypeScript for modern browsers.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src tests",
    "levels": "node tools/build_levels.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node tests/browser/smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.5",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.3.0"
  }
}
